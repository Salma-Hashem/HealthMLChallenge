# -----------------------------------------------------------------------
# Care Coordinator Assistant — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# -----------------------------------------------------------------------

# REQUIRED — Primary Cerebras API key
# Create a free account at https://cloud.cerebras.ai to get your key.
# If you plan to ask many questions, create two separate accounts —
# one for each key below — to avoid hitting rate limits.
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OPTIONAL — Fallback Cerebras API key (used automatically on 429 rate limits)
# Use a key from a second Cerebras account for best results.
CEREBRAS_API_KEY_FALLBACK=your_fallback_cerebras_api_key_here

# OPTIONAL — Flask server settings
FLASK_ENV=development
FLASK_PORT=5000

# -----------------------------------------------------------------------
# LangSmith — LLM evaluation and tracing
# Get a free API key at https://smith.langchain.com
# Run:  pytest tests/test_llm_evals.py
# -----------------------------------------------------------------------

# REQUIRED to run tests/test_llm_evals.py
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# Enables LangChain automatic tracing of all LLM calls to LangSmith
LANGCHAIN_TRACING_V2=true

# LangSmith project name (conversations + eval runs are grouped here)
LANGCHAIN_PROJECT=care-coordinator

# OPTIONAL — set to "true" to enable the LLM-as-judge quality evaluator.
# This makes an extra Cerebras API call per test case (costs credits).
# Leave unset for fast CI runs; enable before a release to check quality.
LANGSMITH_LLM_JUDGE=false
